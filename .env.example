# Laravel backend base URL (no trailing slash). Requests to /api and /sanctum are rewritten here.
API_URL=http://localhost:8000

# Laravel session cookie name (config/session.php `cookie`). Used by proxy.ts for the login redirect only.
SESSION_COOKIE=epic-erp-session

# Workstation print service (browser-side; defaults shown). Printer names must match the installed Windows printer names.
NEXT_PUBLIC_PRINT_SERVICE_URL=http://127.0.0.1:9555
NEXT_PUBLIC_PRINT_API_KEY=epichealthcare@2026printserver
NEXT_PUBLIC_REPORT_PRINTER=report_printer
NEXT_PUBLIC_BARCODE_PRINTER=barcode_printer
NEXT_PUBLIC_LABEL_PRINTER=label_printer
